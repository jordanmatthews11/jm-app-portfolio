rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace with your Google email to restrict Firestore access
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'jordan.matthews@storesight.com';
    }
    // Only owner can read and write portfolio items
    match /portfolio/{docId} {
      allow read, write: if isOwner();
    }
    // Only owner can read and write home content (includes helpful links)
    match /homeContent/{docId} {
      allow read, write: if isOwner();
    }
    // Shortlinks: public read (for redirects), owner can write
    match /redirects/{slug} {
      allow read: if true;
      allow write: if isOwner();
    }
    // Easter egg game leaderboard: public read, any signed-in user can submit
    match /easterEggScores/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    // Everything else: deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
