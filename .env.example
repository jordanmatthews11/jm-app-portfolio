# Copy to .env and fill in from Firebase Console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Restrict login to only this Google email (required for access control)
# Set to your Google email, e.g. you@example.com. Also add to Vercel/Netlify env vars for production.
VITE_ALLOWED_EMAIL=
